{
  "kind": "collectionType",
  "collectionName": "youtube_videos",
  "info": {
    "singularName": "youtube-video",
    "pluralName": "youtube-videos",
    "displayName": "Youtube Video"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "band_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::band-category.band-category",
      "inversedBy": "youtube_videos"
    },
    "location": {
      "type": "string"
    },
    "occasion": {
      "type": "string"
    },
    "video_link": {
      "type": "string"
    },
    "cover_if_any": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "text"
    },
    "singer": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::singer.singer",
      "mappedBy": "youtube_video"
    },
    "band_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::band-type.band-type",
      "inversedBy": "youtube_videos"
    }
  }
}
